{
  "name": "unibootdesktop-frontend",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "predev": "node ../scripts/ensure-wailsjs.mjs",
    "dev": "vite",
    "prebuild": "node ../scripts/ensure-wailsjs.mjs",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "pretest": "node ../scripts/ensure-wailsjs.mjs",
    "test": "vitest run",
    "i18n:check": "node ../scripts/update-locales.mjs --check",
    "i18n:sync": "node ../scripts/update-locales.mjs"
  },
  "dependencies": {
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "5.1.0",
    "vue-tsc": "2.2.12"
  },
  "overrides": {
    "brace-expansion": "2.1.7",
    "minimatch": "11.0.4"
  }
}
